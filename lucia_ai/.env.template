# Lucia AI Environment Configuration Template
# Copy this file to .env and fill in your values

# =============================================================================
# Lucia AI Paths
# =============================================================================
LUCIA_ROOT=/Users/darylharr/Desktop/dis_maops/lucia_ai
LUCIA_CONFIG=${LUCIA_ROOT}/configs/lucia.yaml
LUCIA_DATA=${LUCIA_ROOT}/data
LUCIA_LOGS=${LUCIA_ROOT}/logs
LUCIA_MODELS=${LUCIA_ROOT}/models
LUCIA_CACHE=${LUCIA_ROOT}/cache

# =============================================================================
# Service Ports
# =============================================================================
LUCIA_PORT=8080
LUCIA_AGENT_PORT=8090
LUCIA_OPENAI_AGENT_PORT=8091
LUCIA_OPENAI_INTEGRATION_PORT=3000

# =============================================================================
# AI Backend URLs
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234

# =============================================================================
# API Keys
# =============================================================================
# Option 1: Direct API keys (not recommended for production)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
ELEVENLABS_API_KEY=
XAI_API_KEY=
GITHUB_TOKEN=

# Option 2: 1Password references (recommended)
# OPENAI_API_KEY="op://Lucia-AI-Secrets/OpenAI-API-Key/credential"
# ANTHROPIC_API_KEY="op://Lucia-AI-Secrets/Anthropic-Claude-API-Key/credential"
# XAI_API_KEY="op://Lucia-AI-Secrets/GROK-xAI-API-Key/credential"
# ELEVENLABS_API_KEY="op://Lucia-AI-Secrets/ElevenLabs-API-Key/credential"
# LUCIA_API_KEY="op://Lucia-AI-Secrets/Lucia-API-Key/credential"
# GITHUB_TOKEN="op://Lucia-AI-Secrets/GitHub-Token/credential"

# =============================================================================
# Database Configuration
# =============================================================================
# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# Hardware Configuration
# =============================================================================
LUCIA_DEVICE=auto  # auto, mps, cuda, rocm, cpu
LUCIA_WORKERS=4
LUCIA_MAX_MEMORY_GB=16

# =============================================================================
# Logging
# =============================================================================
LUCIA_LOG_LEVEL=INFO
LUCIA_LOG_FILE=${LUCIA_ROOT}/logs/lucia.log
LUCIA_DEBUG=false

# =============================================================================
# Security
# =============================================================================
LUCIA_API_KEY=
LUCIA_REQUIRE_AUTH=false

# =============================================================================
# dis_maops Integration
# =============================================================================
DIS_MAOPS_ROOT=/Users/darylharr/Desktop/dis_maops
MCP_SERVER_ROOT=${DIS_MAOPS_ROOT}/mcp_tool

# =============================================================================
# Optional: 1Password Integration
# =============================================================================
OP_SERVICE_ACCOUNT_TOKEN=

# =============================================================================
# Development
# =============================================================================
NODE_ENV=production
PYTHON_ENV=production
