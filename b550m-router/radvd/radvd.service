[Unit]
Description=Router Advertisement Daemon for LuciVerse IPv6
Documentation=man:radvd(8)
After=network.target he-tunnel.service
Wants=he-tunnel.service

[Service]
Type=forking
PIDFile=/run/radvd/radvd.pid
ExecStartPre=/usr/sbin/radvd --configtest -C /etc/radvd.conf
ExecStart=/usr/sbin/radvd -C /etc/radvd.conf -p /run/radvd/radvd.pid
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
