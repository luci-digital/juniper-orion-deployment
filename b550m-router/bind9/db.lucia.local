; BIND9 Zone File for lucia.local (mDNS Compatibility)
; LuciVerse Consciousness Realm Local Domain
; Genesis Bond: ACTIVE @ 741 Hz
; Last Updated: 2025-12-09

$ORIGIN lucia.local.
$TTL 3600

; SOA Record
@   IN  SOA  router.lucia.local. admin.lucia.local. (
            2025120901  ; Serial
            3600        ; Refresh
            1800        ; Retry
            604800      ; Expire
            86400 )     ; Minimum TTL

; Nameservers
    IN  NS   router.lucia.local.

; Router (Primary)
router      IN  A    192.168.100.1
router      IN  AAAA 2602:f674:1000::1

; Web Endpoints (IPv6 Primary)

; Media Upload Portal
media       IN  AAAA fd00:741:0700:8664:7e09:7741:0001:0001
media       IN  A    192.168.1.146

; LCARS IDE Control Interface
lcars       IN  AAAA fd00:741:0700:8664:7e09:8008:0001:0001
lcars       IN  A    192.168.1.146

; Orchestrator API
orchestrator IN AAAA fd00:741:0700:8664:7e09:8484:0001:0001
orchestrator IN A    192.168.1.146

; Local Infrastructure

; Main Server (ZBook - 192.168.1.146)
zbook       IN  A    192.168.1.146
zbook       IN  AAAA fd00:741:0700:8664:7e09:0001:0001:0146

; NAS (Synology - typically 192.168.1.179)
nas         IN  A    192.168.1.179
nas         IN  AAAA fd00:741:0700:8664:7e09:0001:0001:0179

; Gateway/Router
gateway     IN  A    192.168.1.254
gateway     IN  AAAA fd00:741:0700:8664:7e09:0001:0001:0254

; B550M Router
b550m       IN  A    192.168.100.1
b550m       IN  AAAA 2602:f674:1000::1

; Aliases for convenience
app         IN  CNAME media.lucia.local.
api         IN  CNAME orchestrator.lucia.local.
ide         IN  CNAME lcars.lucia.local.
www         IN  CNAME media.lucia.local.

; SRV Records
_http._tcp  IN  SRV  10 10 80  media.lucia.local.
_https._tcp IN  SRV  10 10 443 lcars.lucia.local.
_api._tcp   IN  SRV  10 10 80  orchestrator.lucia.local.

; TXT Records (Service Discovery)
media       IN  TXT "consciousness=0.95" "genesis-soul=0x7741"
lcars       IN  TXT "consciousness=0.92" "genesis-soul=0x8008"
orchestrator IN TXT "consciousness=0.88" "genesis-soul=0x8484"
